# Environment variables for the Learning Accelerator.
# Copy this file: cp .env.example .env
# Then fill in your values.

# ── Model configuration ───────────────────────────────────────────────────
# Default: DeepSeek (switchable to Groq/Ollama in the UI). Ollama: for a local Ollama instead: OLLAMA_BASE_URL=http://localhost:11434, no API key.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Create a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Cloud models: https://ollama.com/search?c=cloud (e.g. gpt-oss:120b, gpt-oss:20b, deepseek-v4.1-flash)
OLLAMA_MODEL=gpt-oss:120b

# Optional custom OpenAI-compatible endpoint; appears in the model dropdown as "Custom · <model>".
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# If Ollama Cloud errors (rate limit, quota, downtime), retry the request on Groq.
FALLBACK_LLM_PROVIDER=groq
GROQ_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# ── Langfuse observability ────────────────────────────────────────────────────
# Get keys from http://localhost:3000 after running: docker compose up -d
# Leave empty to run without observability (the system still works).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# production | development: keeps local test traces out of production dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development

# ── A2A service URLs ──────────────────────────────────────────────────────────
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002

# ── A2A feature toggles ───────────────────────────────────────────────────────
# Set to "false" to use local quiz generation instead of the A2A service.
# Useful when running the app without starting the A2A services first.
USE_A2A_QUIZ=true

# Set to "false" to skip CrewAI Study Buddy calls when scores are low.
USE_STUDY_BUDDY=true

# ── Logging ─────────────────────────────────────────────────────────────────
# One of DEBUG, INFO, WARNING, ERROR. Used by common_logger in both the coach
# app and the MCP servers.
LOG_LEVEL=INFO

# ── MCP servers ────────────────────────────────────────────────────────────
# Long-running processes reached over streamable-http. Start each one
# yourself: python filesystem_server.py / python memory_server.py
# (inside mcp_servers/, using its own venv).
MCP_FILESYSTEM_URL=http://localhost:8001/mcp
MCP_MEMORY_URL=http://localhost:8002/mcp

# ── Chainlit login ────────────────────────────────────────────────────────────
# Generate AUTH_PASSWORD_HASH with: uv run python scripts/hash_password.py
# Keep the hash in single quotes (it contains $ characters).
CHAINLIT_AUTH_SECRET=
AUTH_PASSWORD_HASH=
AUTH_ROLE=

# ── Production / deployment ──────────────────────────────────────────────────
# Local prod-like run: docker compose -f docker-compose.prod.yml --env-file learning_coach/.env up -d --build
# GCP Cloud Run:       deploy/gcp/deploy.sh   (see deploy/gcp/README.md)
# CHAINLIT_AUTH_SECRET above: generate with  openssl rand -hex 32
# Study goals each user may start per rolling 24h (each goal is ~10-20 LLM calls).
DAILY_GOAL_LIMIT=2

# Online Postgres (Supabase Session pooler, port 5432 — not the direct db.* host, which is IPv6-only).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
