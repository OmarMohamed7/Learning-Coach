# Public hostname. No domain? Use <server-ip>.nip.io (free, HTTPS works), e.g. 129.146.1.2.nip.io
DOMAIN=
POSTGRES_PASSWORD=
# openssl rand -hex 32
CHAINLIT_AUTH_SECRET=
# CPU-only free VM: keep it small. llama3.1:8b works but is slow (minutes per explanation).
OLLAMA_MODEL=qwen2.5:3b
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Free hosted LLM: set LLM_PROVIDER=gemini (or groq) and the matching key; ollama otherwise.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GROQ_API_KEY=
